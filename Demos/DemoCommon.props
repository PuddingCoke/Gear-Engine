<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_DelayLoadDllFiles Condition="Exists('$(SolutionDir)Dlls')">$([System.IO.Directory]::GetFiles('$(SolutionDir)Dlls', '*.dll'))</_DelayLoadDllFiles>

    <!-- C:\a\b.dll;C:\c\d.dll -> b.dll;d.dll -->
    <_DelayLoadDllNames>$([System.Text.RegularExpressions.Regex]::Replace('$(_DelayLoadDllFiles)', '[^;]*\\', ''))</_DelayLoadDllNames>

    <!-- b.dll;d.dll -> /DELAYLOAD:"b.dll" /DELAYLOAD:"d.dll" -->
    <_DelayLoadOptions>$([System.Text.RegularExpressions.Regex]::Replace('$(_DelayLoadDllNames)', '([^;]+);?', '/DELAYLOAD:"$1" '))</_DelayLoadOptions>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) $(_DelayLoadOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

</Project>